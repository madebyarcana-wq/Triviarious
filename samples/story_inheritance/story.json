  "legal_checks": [
    {
      "claim": "自筆の遺言書は、家庭裁判所の検認を受ける。検認は遺言が有効かどうかを決める手続きではない",
      "status": "確認済み",
      "note": "兄の『裁判所で確認済み』という言い分が、遺言の有効性の保証にはならない、という作中の流れと合う",
      "source_url": "https://www.courts.go.jp/saiban/syurui/syurui_kazi/kazi_06_17/index.html"
    },
    {
      "claim": "封のある遺言書を家庭裁判所の外で開けると、5万円以下の過料になることがある",
      "status": "確認済み",
      "note": "作中で兄が親戚の前で広げた遺言書は、封のないものという設定にした",
      "source_url": "https://www.courts.go.jp/saiban/syurui/syurui_kazi/kazi_06_17/index.html"
    },
    {
      "claim": "法務局に預けた遺言書(自筆証書遺言書保管制度)は、家庭裁判所の検認がいらない",
      "status": "確認済み",
      "note": "法務局の案内資料で確認",
      "source_url": "https://houmukyoku.moj.go.jp/nara/content/001322348.pdf"
    },
    {
      "claim": "遺言書を預ける手続きは、遺言者本人が法務局へ行って行う",
      "status": "確認済み",
      "note": "本人出頭が必要。作中では叔母が付き添った。なお法務局は字が本人のものかまでは確認しないため、作中では叔母が書く姿を見ていた証言を合わせて根拠にしている",
      "source_url": "https://houmukyoku.moj.go.jp/nara/content/001322348.pdf"
    },
    {
      "claim": "預けると、名前・生年月日・保管所の名称・保管番号が書かれた保管証が渡される",
      "status": "確認済み",
      "note": "法務局の案内資料で確認",
      "source_url": "https://houmukyoku.moj.go.jp/nara/content/001322348.pdf"
    },
    {
      "claim": "相続人は、遺言者の死亡後に遺言書情報証明書を請求できる",
      "status": "確認済み",
      "note": "請求には戸籍などの書類が必要になるため、作中では書類をそろえる期間を置いた",
      "source_url": "https://houmukyoku.moj.go.jp/kofu/content/001354391.pdf"
    },
    {
      "claim": "前の遺言と後の遺言が抵触する部分は、後の遺言で前の遺言を撤回したものとみなす(民法1023条)",
      "status": "確認済み",
      "note": "撤回とみなされるのは、ぶつかる部分だけ",
      "source_url": "https://law-lib.jp/subjects/2/provisions/1269"
    },
    {
      "claim": "子2人だけが相続人のとき、遺留分は全体の2分の1で、1人あたり4分の1(民法1042条)",
      "status": "確認済み",
      "note": "新しい遺言で兄は預金の半分(3,000万円)を受け取るため、家の価値を加えても兄の遺留分(全体の4分の1)は侵害されない設定",
